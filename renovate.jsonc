// Renovate (docs/adr/0018, docs/tooling/renovate.md). Updates the versions this repository pins:
// mise.toml and mise.lock, the commit SHAs of GitHub Actions, and the pnpm-workspace.yaml catalog.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // PR titles become commits on main and must pass commitlint (docs/adr/0004).
  // Renovate only detects Conventional Commits from the history of main, so state it.
  // config:recommended makes the type `fix` for the `dependencies` depType; :semanticCommitTypeAll overrides that.
  "extends": ["config:best-practices", ":semanticCommitTypeAll(chore)"],
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  // Renovate merges some of its PRs itself (docs/adr/0055): lock file maintenance, and the minor and patch updates of
  // npm packages that are 1.0 or later. It uses GitHub's auto-merge, which merges once the required checks of
  // protect-main pass (.github/rulesets/protect-main.json), so the repository setting "Allow auto-merge" must be on.
  // The rules below turn automerge on; the last rules turn it off again for what stays with a person. A PR that fails
  // a check is left open as before. Every PR that is merged by itself carries the label `automerge`, so that a revert
  // can be traced to it (docs/tooling/renovate.md). `labels` is not merged between rules: the last matching rule
  // wins, so the rules for a person's PRs set `labels` to [].
  // To stop all automerge, add { "matchPackageNames": ["*"], "automerge": false, "labels": [] } as the last rule and set
  // lockFileMaintenance.automerge to false (docs/tooling/renovate.md). Turning off "Allow auto-merge" does not
  // stop it: Renovate then merges the PR itself.
  // tools/scripts/src/checks/repo-policy/tooling.ts keeps this bounded.
  "lockFileMaintenance": { "automerge": true, "labels": ["automerge"] },
  "packageRules": [
    {
      // ADR 0003: stay on betterleaks v1 until v2 is stable and the ADR is revisited.
      "description": "Do not update betterleaks to a new major version",
      "matchDepNames": ["betterleaks"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
    {
      // tools/scripts/src/checks/repo-policy/cli.ts requires betterleaksMinVersion to equal the version in mise.toml.
      "description": "Update betterleaks in mise.toml, mise.lock and .betterleaks.toml in one PR",
      "matchDepNames": ["betterleaks"],
      "groupName": "betterleaks",
    },
    {
      // The GitHub release tag is v1.10.0, and Renovate wrote `betterleaks = "v1.10.0"` in mise.toml. That differs from
      // betterleaksMinVersion ("1.10.0"), so repo-policy failed. Keep the v out of the version, as the customManager below does.
      "description": "Write the betterleaks version in mise.toml without the v of the release tag",
      "matchDepNames": ["betterleaks"],
      "matchManagers": ["mise"],
      "extractVersion": "^v?(?<version>.+)$",
    },
    {
      // ADR 0013: one Node.js major version, set by .node-version. A major update changes the Lambda runtime,
      // the API build target and engines.node, so a person does it.
      "description": "Do not update Node.js or @types/node to a new major version",
      "matchDepNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
    },
    {
      // The runner image is a platform choice (ubuntu-26.04, the same release as the WSL in docs/local-env-setup/setup.md), not a pinned tool version.
      "description": "Do not update the runs-on image",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["github-runner"],
      "enabled": false,
    },
    {
      // pnpm-workspace.yaml pins minimatch 10.2.5 for nx and @nx/devkit only: nx 24.0.5 calls minimatch.makeRe, which 11
      // does not have (PR #667). The open alert of minimatch made Renovate raise security PRs that undo the pin (#668,
      // #669). Remove this rule with the two overrides when nx depends on minimatch 11 (docs/tooling/renovate.md).
      "description": "Do not update the minimatch that nx and @nx/devkit are pinned to",
      "matchDepNames": ["nx>minimatch", "@nx/devkit>minimatch"],
      "enabled": false,
    },
    {
      // ADR 0056: @vitejs/plugin-react declares the peer range `oxc-transform-react >=0.152.0 <0.157.0`. Stay inside it
      // until plugin-react widens it. Remove this rule then.
      "description": "Keep oxc-transform-react inside the peer range of @vitejs/plugin-react",
      "matchDepNames": ["oxc-transform-react"],
      "allowedVersions": "<0.157.0",
    },
    {
      // ADR 0028: each @effect/tsgo release supports a range of Oxlint and oxlint-tsgolint (its README), and Vite+
      // carries them. So a Vite+ update outside that range must not merge alone, nor an @effect/tsgo update that
      // needs a Vite+ not yet installed. The `vite` entry of the catalog is Vite+'s core package.
      "description": "Update @effect/tsgo and Vite+ in one PR",
      "matchPackageNames": ["@effect/tsgo", "vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "effect-tsgo and vite-plus",
    },
    {
      // Renovate releases almost daily. One PR a week is enough for the copy that tools/scripts/sh/renovate.sh runs.
      "description": "Update the Renovate in tools/scripts/sh/renovate.sh once a week",
      "matchDepNames": ["renovate"],
      "schedule": ["before 4am on monday"],
    },
    {
      // Renovate's own guidance: automerge what you would merge anyway, and keep the major versions and the 0.x
      // versions (which may break at any time) for a person. CI exercises these, so a failing update stays open.
      "description": "Automerge minor and patch updates of npm packages that are 1.0 or later",
      "matchManagers": ["npm"],
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "labels": ["automerge"],
    },
    // GitHub Actions and mise tools are not merged by Renovate at any version. An Action runs inside CI and its update
    // changes .github/workflows. A scanner (betterleaks, zizmor, osv-scanner, semgrep) that stops finding things looks the
    // same as a pass. A person reads these PRs (docs/adr/0055).
    // The next two come last, so that they win over the rules above.
    {
      // The Node.js runtime is set together with the Lambda runtime (ADR 0013). pnpm runs every check, so a person
      // reads its update (a judgement). The authentication libraries are read by a person even when the tests pass.
      // kiro-cli is the coding agent itself, and its release notes are read before it runs in CI (docs/adr/0057).
      "description": "A person merges Node.js, pnpm, kiro-cli and the authentication libraries",
      "matchDepNames": ["node", "pnpm", "kiro-cli", "better-auth", "oidc-provider"],
      "automerge": false,
      "labels": [],
    },
    {
      // ADR 0028: the PR of @effect/tsgo and Vite+ must fit the range of Oxlint, and a person checks that.
      "description": "A person merges the PR of @effect/tsgo and Vite+",
      "matchPackageNames": ["@effect/tsgo", "vite-plus", "@voidzero-dev/vite-plus-core"],
      "automerge": false,
      "labels": [],
    },
  ],
  // The official version list of Kiro CLI (docs/adr/0057). The official installer reads this index.json, so it is the
  // registry URL. The mise manager skips `http:` tools (unsupported-datasource), hence the regex manager below.
  "customDatasources": {
    "kiro-cli": {
      "defaultRegistryUrlTemplate": "https://prod.download.cli.kiro.dev/stable/index.json",
      "format": "json",
      "transformTemplates": ["{ \"releases\": versions.{ \"version\": version } }"],
    },
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Renovate version in tools/scripts/sh/renovate.sh",
      "managerFilePatterns": ["/^tools\\/scripts\\/sh\\/renovate\\.sh$/"],
      "matchStrings": ["renovate_version=\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
    },
    {
      "customType": "regex",
      "description": "betterleaksMinVersion in .betterleaks.toml",
      "managerFilePatterns": ["/^\\.betterleaks\\.toml$/"],
      "matchStrings": ["betterleaksMinVersion\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "betterleaks",
      "packageNameTemplate": "betterleaks/betterleaks",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
    },
    {
      "customType": "regex",
      "description": "The version of the http:kiro-cli table in mise.toml",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": [
        "\\[tools\\.\"http:kiro-cli\"\\]\\s*\\nversion\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
      "depNameTemplate": "kiro-cli",
      "datasourceTemplate": "custom.kiro-cli",
    },
  ],
}

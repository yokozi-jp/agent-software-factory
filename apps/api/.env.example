# 手元で API を認証つきで動かす設定 (docs/tooling/local-api.md)。この名前で `.env` に写すと、`pnpm dev:auth` が読む。
# 値は compose.local.yaml と、`pnpm dev:idp` (test/dev-idp.ts) に合わせてある。
# key は src/env.ts の schema と一致させる (src/env.unit.test.ts が確かめる)。
PORT=3000
# ブラウザが開く origin。web の開発サーバー (5173) が /api を API へ転送するので、Cookie の `__Host-` と `SameSite=Strict` は 5173 で成り立つ (docs/adr/0022)。
PUBLIC_ORIGIN=http://localhost:5173
AUTH_SECRET=local-auth-secret-0123456789abcdef # betterleaks:allow
AUTH_DATABASE_URL=postgres://auth_service:local-password@127.0.0.1:5432/app?sslmode=disable # betterleaks:allow
APP_DATABASE_URL=postgres://app_user:local-password@127.0.0.1:5432/app?sslmode=disable # betterleaks:allow
OIDC_DISCOVERY_URL=http://127.0.0.1:9000/.well-known/openid-configuration
OIDC_CLIENT_ID=api
OIDC_CLIENT_SECRET=test-client-secret # betterleaks:allow
# ログのレベル (debug、info、warn、error)。ローカルと開発は debug、検証と本番は info (docs/adr/0049)
LOG_LEVEL=debug
# ログの service.version と deployment.environment
SERVICE_VERSION=local
DEPLOYMENT_ENVIRONMENT=local

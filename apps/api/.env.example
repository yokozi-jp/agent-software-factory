# ローカル用の見本。`cp .env.example .env` して値を入れる。.env は commit しない。
# key は src/env.ts の schema と一致させる (src/env.test.ts が確かめる)。

# 待ち受けるポート
PORT=3000
# auth_service のロールで接続する (docs/adr/0022、docs/adr/0025)
AUTH_DATABASE_URL=postgres://auth_service:change-me@localhost:5432/app # betterleaks:allow
# 業務の処理は app_user のロールで接続する (docs/adr/0011、docs/db/postgresql-client.md)
APP_DATABASE_URL=postgres://app_user:change-me@localhost:5432/app # betterleaks:allow
# ブラウザから見える API のオリジン
PUBLIC_ORIGIN=http://localhost:3000
# Better Auth の署名鍵。ローカルでも推測できない値にする
AUTH_SECRET=change-me # betterleaks:allow
OIDC_DISCOVERY_URL=http://localhost:8080/realms/example/.well-known/openid-configuration
OIDC_CLIENT_ID=api
OIDC_CLIENT_SECRET=change-me # betterleaks:allow
# ログのレベル (debug、info、warn、error)。ローカルと開発は debug、検証と本番は info (docs/adr/0049)
LOG_LEVEL=debug
# ログの service.version と deployment.environment
SERVICE_VERSION=local
DEPLOYMENT_ENVIRONMENT=local

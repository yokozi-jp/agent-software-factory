{
  "name": "@agent-software-factory/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/contract.ts"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vp test run --coverage",
    "check": "vp check",
    "openapi": "node --import ./test/temporal.ts ../../tools/scripts/src/openapi/cli.ts",
    "contract-lint": "sh ../../tools/scripts/sh/openapi-lint.sh",
    "contract-breaking": "sh ../../tools/scripts/sh/openapi-breaking.sh"
  },
  "dependencies": {
    "@agent-software-factory/approval": "workspace:*",
    "@agent-software-factory/claim": "workspace:*",
    "@agent-software-factory/closing": "workspace:*",
    "@agent-software-factory/db": "workspace:*",
    "@agent-software-factory/shared-kernel": "workspace:*",
    "@agent-software-factory/telemetry": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/otel": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "hono": "catalog:",
    "kysely": "catalog:",
    "pg": "catalog:",
    "temporal-polyfill": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/sdk-trace": "catalog:",
    "@types/node": "catalog:",
    "@types/oidc-provider": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oidc-provider": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "nx": {
    "name": "api",
    "targets": {
      "contract-lint": {
        "cache": true,
        "inputs": [
          "{projectRoot}/openapi.json",
          "{workspaceRoot}/.spectral.yaml",
          "{workspaceRoot}/mise.toml",
          "{workspaceRoot}/mise.lock"
        ]
      },
      "contract-breaking": {
        "cache": false
      }
    }
  }
}

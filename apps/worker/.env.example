# 手元でワーカーを動かす設定 (docs/tooling/local-worker.md)。この名前で `.env` に写すと、`pnpm start` と
# `pnpm setup-queues`、`pnpm send-sample` が読む。値は compose.local.yaml に合わせてある。
APP_DATABASE_URL=postgres://app_user:local-password@127.0.0.1:5432/app # betterleaks:allow
MAIL_FROM=noreply@example.com
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# キュー名 notification-mail は `setup-queues` が作る名前。
NOTIFICATION_QUEUE_URL=http://127.0.0.1:9324/000000000000/notification-mail
SQS_ENDPOINT=http://127.0.0.1:9324
# ElasticMQ は認証しないが、SQS の SDK は region と認証情報の存在を求める。仮の値でよい。
# AWS_USE_DUALSTACK_ENDPOINT は渡さない (docs/adr/0041)。
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

{
  // story だけの program。packages/ui/tsconfig.json は story を除く (理由はそこに書いた)。
  // repo-policy が、root の tsconfig.json を直接 extends することを求める (docs/adr/0020)。
  "extends": "../../../../tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": []
  },
  "include": ["*.stories.tsx"]
}

// Unused files, exports and dependencies in every pnpm workspace project and the root (docs/adr/0017).
// Each entry and ignore below is an exception Knip cannot see by itself; its reason is written next to it.
{
  // The JSONC schema allows the trailing commas that vp fmt writes.
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // A hint means an exception here is no longer needed (or no longer matches). Fail, so stale exceptions get removed.
  "treatConfigHintsAsErrors": true,
  // Installed outside npm (docs/adr/0009). secret-scan and semgrep in tools/scripts run `mise exec`.
  "ignoreBinaries": ["mise"],
  // Detection-power fixtures of the lint rules and tsconfig flags (#43, #230): each breaks a rule on purpose, and
  // nothing imports them (docs/adr/0026). Knip does not read a file it reports as unused, so their imports are not
  // checked. A *.test.ts fixture is still an entry for Knip's Vitest plugin, so it must not import a dependency that
  // only the fixtures use (packages/*/src/{application,infrastructure}/__fixtures__/effect.test.ts imports no effect).
  // packages/i18n/test/__fixtures__ are the same for the key check (docs/adr/0044): a tree of screens and resources.
  "ignoreFiles": ["{apps,packages}/*/src/**/__fixtures__/**", "packages/i18n/test/__fixtures__/**"],
  // kysely-codegen writes an interface for each table and uses it in `DB` of the same file (docs/adr/0025). The code
  // uses `DB`; whether it also names a table's interface is up to the code, and the generator cannot know it.
  "ignoreIssues": {
    "packages/*/src/infrastructure/db.gen.ts": ["types"],
    "packages/shared-kernel/src/messaging.gen.ts": ["types"],
  },
  "workspaces": {
    ".": {
      // Knip's default project files, without the agent skills installed from upstream (skills-lock.json).
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!.agents/**"],
      "ignoreDependencies": [
        // Run as a binary outside package.json: node_modules/.bin/iwe in tools/scripts/src/checks/docs-check/cli.ts,
        // and `pnpm exec iwec` (the MCP server) in .kiro/settings/mcp.json.
        "@iwe-org/iwe",
        // nx release loads @nx/js/src/release/version-actions when nx.json sets no versionActions.
        "@nx/js",
      ],
    },
    "tools/scripts": {
      // tools/scripts/sh/renovate.sh preview runs the renovate-preview entry with node, and .kiro/hooks/*.json
      // runs the Kiro hook entries with node. Knip does not read shell scripts or those files. A person runs
      // the factory metrics entry and the agent-probe entry by hand (docs/agents/factory-metrics.md,
      // docs/tooling/agent-permissions.md).
      "entry": [
        "src/checks/renovate-preview/cli.ts",
        "src/hooks/*/cli.ts",
        "src/metrics/cli.ts",
        "src/agent-probe/cli.ts",
      ],
    },
    // module-fixtures holds only the fixtures of the overrides that reach every module (docs/adr/0026). They import
    // effect, and Knip does not read __fixtures__/, so the dependency always looks unused.
    "packages/module-fixtures": { "ignoreDependencies": ["effect"] },
    "packages/ui": {
      // Parts that `shadcn add` writes into components/ (docs/adr/0033, 0034). The code is the library's, so it has
      // unused exports (variants, sub-parts) by design, and the parts are not imported until a screen uses them.
      // As entries, their exports are not reported, and what they import (@base-ui/react, cn, ...) counts as used.
      // lib/utils.ts, the file `aliases.utils` of components.json names, is an entry too: Knip reads it from the
      // `exports` of package.json (./lib/*), so it needs no pattern here.
      "entry": ["src/components/**/*.tsx"],
      // The stories of the parts (docs/adr/0033, #315). Knip's Storybook plugin reads every *.stories.tsx as an entry by
      // default, fixtures included, and then reports the dependencies they name on purpose (@storybook/react,
      // @testing-library/dom: src/__fixtures__/*.stories.tsx) as unlisted. The fixtures are not stories of the catalog.
      "storybook": { "entry": ["src/components/**/*.stories.tsx"] },
    },
    "packages/i18n": {
      // The config of i18next-cli: the i18n-keys and i18n-lint scripts and the fixtures' test run it with --config, and
      // nothing imports it (docs/adr/0044).
      "entry": ["i18next.config.ts"],
    },
    // db depends on the modules by `import type` only (docs/adr/0038). The seed imports the type of
    // the claim module. Nothing imports approval and closing yet except fixtures, which Knip does not read; their seeds
    // will. Remove an entry when a file other than a fixture imports the module.
    "packages/db": {
      "ignoreDependencies": ["@agent-software-factory/approval", "@agent-software-factory/closing"],
    },
    "apps/api": {
      // The SDK clients that no-restricted-imports stops (docs/adr/0029, outboxPackages in vite.config.ts). The fixture
      // src/__fixtures__/bypass.test.ts imports them to show the override of the entry files and the tests still stops
      // them; Knip reads a *.test.ts fixture, and the app depends on none of them (and must not). Remove an entry
      // when the list in vite.config.ts drops the package.
      "ignoreDependencies": [
        "@aws-sdk/client-eventbridge",
        "@aws-sdk/client-lambda",
        "@aws-sdk/client-ses",
        "@aws-sdk/client-sesv2",
        "@aws-sdk/client-sfn",
        "@aws-sdk/client-sns",
        "@aws-sdk/client-sqs",
      ],
      "entry": [
        // The dev server entry (@hono/vite-dev-server in vite.config.ts), also Knip's default.
        "src/index.ts",
        // The production entry: build.ssr in vite.config.ts. The start script runs its output, dist/server.js.
        "src/server.ts",
      ],
    },
  },
}

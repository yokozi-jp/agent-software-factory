// Unused files, exports and dependencies in every pnpm workspace project and the root (docs/adr/0017).
// Each entry and ignore below is an exception Knip cannot see by itself; its reason is written next to it.
{
  // The JSONC schema allows the trailing commas that vp fmt writes.
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // A hint means an exception here is no longer needed (or no longer matches). Fail, so stale exceptions get removed.
  "treatConfigHintsAsErrors": true,
  // Installed outside npm (docs/adr/0009). secret-scan and semgrep in tools/scripts run `mise exec`.
  "ignoreBinaries": ["mise"],
  // Detection-power fixtures of the lint rules and tsconfig flags (#43, #230): each breaks a rule on purpose, and
  // nothing imports them (docs/adr/0026). Knip does not read a file it reports as unused, so their imports are not
  // checked. A *.test.ts fixture is still an entry for Knip's Vitest plugin, so it must not import a dependency that
  // only the fixtures use (packages/*/src/{application,infrastructure}/__fixtures__/effect.test.ts imports no effect).
  "ignoreFiles": ["{apps,packages}/*/src/**/__fixtures__/**"],
  // kysely-codegen writes an interface for each table and uses it in `DB` of the same file (docs/adr/0025). The code
  // uses `DB`; whether it also names a table's interface is up to the code, and the generator cannot know it.
  "ignoreIssues": { "packages/*/src/infrastructure/db.gen.ts": ["types"] },
  "workspaces": {
    ".": {
      // Knip's default project files, without the agent skills installed from upstream (skills-lock.json).
      "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!.agents/**"],
      "ignoreDependencies": [
        // Run as a binary outside package.json: node_modules/.bin/iwe in tools/scripts/src/checks/docs-check/cli.ts,
        // and `pnpm exec iwec` (the MCP server) in .kiro/settings/mcp.json.
        "@iwe-org/iwe",
        // nx release loads @nx/js/src/release/version-actions when nx.json sets no versionActions.
        "@nx/js",
      ],
    },
    "tools/scripts": {
      // tools/scripts/sh/renovate.sh preview runs the renovate-preview entry with node, and .kiro/hooks/*.json
      // runs the Kiro hook entries with node. Knip does not read shell scripts or those files. A person runs
      // the factory metrics entry and the agent-probe entry by hand (docs/agents/factory-metrics.md,
      // docs/tooling/agent-permissions.md).
      "entry": [
        "src/checks/renovate-preview/cli.ts",
        "src/hooks/*/cli.ts",
        "src/metrics/cli.ts",
        "src/agent-probe/cli.ts",
      ],
    },
    // The modules depend on effect for application/ and infrastructure/ (docs/adr/0028), which have no code yet:
    // the sample feature writes it. Their fixtures import it, and Knip does not read __fixtures__/. Remove an entry
    // when the module's application or infrastructure imports effect.
    "packages/claim": { "ignoreDependencies": ["effect"] },
    "packages/approval": { "ignoreDependencies": ["effect"] },
    "packages/closing": { "ignoreDependencies": ["effect"] },
    "apps/api": {
      "entry": [
        // The dev server entry (@hono/vite-dev-server in vite.config.ts), also Knip's default.
        "src/index.ts",
        // The production entry: build.ssr in vite.config.ts. The start script runs its output, dist/server.js.
        "src/server.ts",
      ],
    },
  },
}

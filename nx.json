{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/vite.config.ts",
      "{workspaceRoot}/lint-restrictions.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/.node-version"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx}",
      "!{projectRoot}/**/__fixtures__/**"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "check": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "db-types-check": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "i18n-keys": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/packages/i18n/**/*", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "lint-effect": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/oxlint.effect.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/packages/shared-kernel/src/**/*"
      ]
    }
  },
  "release": {
    "projects": ["api", "web"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": "github"
      }
    },
    "git": {
      "commitMessage": "chore: release"
    }
  }
}

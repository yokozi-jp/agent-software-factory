{
  "name": "@agent-software-factory/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp test run --project unit --coverage",
    "test-isolation": "vp test run --project isolation",
    "test-tools": "vp test run --project tools",
    "mutation": "stryker run"
  },
  "dependencies": {
    "smol-toml": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "nx": {
    "name": "scripts",
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/.kiro/hooks/*.json"
        ]
      },
      "test-tools": {
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/.betterleaks.toml",
          "{workspaceRoot}/mise.toml",
          "{workspaceRoot}/mise.lock",
          "{workspaceRoot}/.mise/locks/**/*",
          "{workspaceRoot}/docs/.iwe/config.toml",
          "{workspaceRoot}/docs/.iwe/schemas/okf.yaml",
          "{workspaceRoot}/docs/.iwe/schemas/okf-index.yaml",
          "{workspaceRoot}/docs/.iwe/schemas/okf-log.yaml",
          "{workspaceRoot}/.github/jactionlint.yaml",
          "{workspaceRoot}/.github/workflows/*.{yml,yaml}",
          "{workspaceRoot}/.gitignore",
          "{workspaceRoot}/.jscpd.json",
          "{workspaceRoot}/.kiro/settings/mcp.json",
          "{workspaceRoot}/.markdownlint-cli2.yaml",
          "{workspaceRoot}/.spectral.yaml",
          "{workspaceRoot}/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
          "{workspaceRoot}/knip.jsonc",
          "{workspaceRoot}/lefthook.yml",
          "{workspaceRoot}/nx.json",
          "{workspaceRoot}/oxlint.effect.json",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/pnpm-lock.yaml",
          "{workspaceRoot}/renovate.jsonc"
        ]
      },
      "mutation": {
        "cache": true,
        "inputs": [
          "default"
        ],
        "outputs": [
          "{projectRoot}/reports/stryker-incremental.json"
        ]
      }
    }
  }
}

  "raw-sql": {
    "adr": "docs/adr/0029",
    "values": ["sql", "CompiledQuery"],
    "message": "Do not write raw SQL in a module: `sql` and `CompiledQuery` skip the types of the Kysely builder, so a query can reach a table of another module. Use the builder on your own tables, and read another module's data through its public API function (docs/adr/0029). If a query truly needs raw SQL, put the reason on the disable comment.",
    "mentions": ["public API function"],
    "rows": [
      {
        "files": [
          "packages/module-fixtures/src/__fixtures__/raw-sql.ts",
          "packages/module-fixtures/src/application/__fixtures__/raw-sql.ts",

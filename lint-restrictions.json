          "packages/module-fixtures/src/http/__fixtures__/raw-sql.ts"
        ],
        "rule": "no-restricted-imports",
        "text": "{ sql } from \"kysely\"",
        "expect": "stop",
        "reason": "sql のタグは Kysely の型を飛ばし、ほかのモジュールの表に届くので、モジュールは自分の表を builder で読む"
      },
      {
        "files": [
          "packages/module-fixtures/src/__fixtures__/raw-sql.ts",
          "packages/module-fixtures/src/application/__fixtures__/raw-sql.ts",
          "packages/module-fixtures/src/infrastructure/__fixtures__/raw-sql.ts",
          "packages/module-fixtures/src/http/__fixtures__/raw-sql.ts"
        ],
        "rule": "no-restricted-imports",
        "text": "{ CompiledQuery } from \"kysely\"",
        "expect": "stop",
        "reason": "CompiledQuery は Kysely の型を飛ばし、ほかのモジュールの表に届くので、モジュールは自分の表を builder で読む"
      }
    ]

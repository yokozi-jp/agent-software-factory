{
  "name": "agent-software-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "check": "nx run-many -t check",
    "check:root": "tools/scripts/sh/check-root-files.sh",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:dup": "jscpd",
    "lint:unused": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/config-nx-scopes": "catalog:",
    "@commitlint/types": "catalog:",
    "@iwe-org/iwe": "catalog:",
    "@nx/js": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "markdownlint-cli2": "catalog:",
    "nx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24"
  }
}

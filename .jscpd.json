{
  "path": ["."],
  "pattern": "{apps,packages}/**",
  "format": ["javascript", "jsx", "typescript", "tsx", "css"],
  "ignore": [
    "**/routeTree.gen.ts",
    "**/db.gen.ts",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "packages/ui/src/styles/globals.css"
  ],
  "gitignore": true,
  "threshold": 0,
  "reporters": ["console"],
  "failOnEmpty": true,
  "noColors": true
}
